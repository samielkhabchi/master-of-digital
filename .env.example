# --- Digiseller -----------------------------------------------------------
# Your seller ID (Digiseller dashboard, top right / profile). Required.
DIGISELLER_SELLER_ID=
# Affiliate (agent) ID added to partner items' checkout links as ?ai=...
# Leave empty to use the seller ID (usually the same number).
DIGISELLER_AGENT_ID=
# Checkout link template. {id} = product id, {lang} = en-US|ru-RU, {cur} = USD|RUR.
# DIGISELLER_CHECKOUT_URL=https://www.oplata.info/asp2/pay_wm.asp?id_d={id}&lang={lang}
# Set to 1 to use built-in sample data instead of the real API (local dev).
DIGISELLER_MOCK=0

# --- Site -----------------------------------------------------------------
SITE_URL=https://masterofdigital.com
TELEGRAM_SUPPORT_URL=https://t.me/your_support_handle
# Digiseller buyer area ("My purchases") – buyers log in with their email.
PURCHASES_URL=https://www.oplata.info/info/

# --- Sync -----------------------------------------------------------------
SYNC_INTERVAL_MINUTES=15
DETAILS_MAX_AGE_HOURS=24
# Long random string; enables POST /api/sync with "Authorization: Bearer <secret>".
SYNC_SECRET=
